# GEMINI_API_KEY: Required for Gemini AI API calls.
# On Vercel: Set this in Project Settings -> Environment Variables.
# In AI Studio: Automatically injected from user secrets.
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# APP_URL: Optional for production Vercel deployments.
# Vercel automatically populates VERCEL_URL if needed.
APP_URL="https://your-project.vercel.app"
